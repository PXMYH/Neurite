{
  "name": "neurite",
  "version": "1.0.0",
  "type": "module",
  "description": "fractal mind map",
  "scripts": {
    "prestart": "node scripts/ensure-worktree-node-modules.js",
    "start": "vite",
    "prestart:host": "node scripts/ensure-worktree-node-modules.js",
    "start:host": "vite --host",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "verify:served": "node scripts/verify-served.mjs",
    "verify:dist": "node scripts/verify-served.mjs --dist",
    "build": "vite build",
    "postbuild": "shx cp -r js dist/js && shx cp -r resources dist/resources && shx cp -r wiki dist/wiki && tsc -p tsconfig.build.json && shx rm -f 'dist/js/**/*.ts'"
  },
  "keywords": [],
  "author": "satellitecomponent",
  "license": "ISC",
  "devDependencies": {
    "vite": "^6.1.1",
    "shx": "^0.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
  },
  "overrides": {
    "glob": "^11.0.1",
    "vite": {
      "esbuild": "^0.25.0"
    }
  }
}
