# Copy to .env in this directory and fill in the keys you actually use.
# ai-proxy.js reads these via dotenv; every one is optional — the frontend can
# also POST keys to /api-keys at runtime instead.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CUSTOM_API_KEY=

# Defaults to http://127.0.0.1:11434/api/ when unset.
OLLAMA_BASE_URL=
